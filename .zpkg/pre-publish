#!/usr/bin/env sh
set -eu
sh ./.zpkg/pre-build
cargo test --workspace --all-targets --locked
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --exit-code -- .zpkg.toml .zpkg Cargo.toml Cargo.lock interfaces-source.lock.json scripts src/routes/health.rs
fi
