namespace Ores.ServerFilesystemRouting;
enum WebServerKind { web, admin_web }
model WebPageFileContract { authored_required: ["page.rs"]; authored_optional: ["gen.rs", "layout.rs"]; generated: ["lambda.rs"]; }
model UrlSegmentGrammar {
  static_segment: "literal-directory-name";
  dynamic_segment: "[name]";
  catch_all_segment: "[...name]";
  optional_catch_all_segment: "[[...name]]";
  parameter_name_charset: "ascii_alnum_underscore_hyphen";
  duplicate_parameter_names: false;
  catch_all_must_be_final: true;
  hidden_route_groups: false;
  one_to_one_url_mapping: true;
}
model LayoutInheritanceContract {
  file: "layout.rs";
  abi: "PageLayoutFn(PageContext,PageDocument)->PageLayoutFuture";
  scope: "ancestor_directories_under_src_pages";
  discovery_order: "root_to_leaf";
  application_order: "leaf_to_root";
  root_layout_is_outermost: true;
  changes_url: false;
  runtime_filesystem_walk: false;
}
model WebGenerationContract {
  orchestrator: "ores-stack";
  lambda_codegen_owner: "ores-api-docs";
  lambda_source_authority: "page.rs";
  lambda_generated_marker: "// @generated by ores-api-docs for a *-web-server.rs page; DO NOT EDIT.";
  provider_neutral_lambda: true;
  standalone_and_lambda_share_page_entry: true;
  rpc_generated: false;
}
model WebServerFilesystemContract {
  schema_version: "ores.server-filesystem-routing.v1";
  server_kind: WebServerKind;
  page_root: "src/pages";
  files: WebPageFileContract;
  url: UrlSegmentGrammar;
  layouts: LayoutInheritanceContract;
  generation: WebGenerationContract;
}
